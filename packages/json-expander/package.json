{
  "name": "@omnigen-org/json-expander",
  "version": "0.0.109",
  "private": false,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "json-expand": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rimraf ./dist && tsc --project ./tsconfig.build.json",
    "version-patch": "pnpm version patch",
    "publish-snapshot": "npm version --no-git-tag-version \"$(node -p 'require(\"./package.json\").version + \"-SNAPSHOT.\" + new Date().toISOString().replace(/[-:T.Z]/g, \"\")')\" && pnpm publish --tag snapshot --force --access public --no-git-checks=true",
    "publish-release": "pnpm publish --tag latest --force --access public --no-git-checks=true"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.1.0",
    "@omnigen-org/core-debug": "workspace:*",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "change-case": "^5.4.4",
    "debug": "^4.3.7",
    "json-pointer": "^0.6.2"
  },
  "devDependencies": {
    "@omnigen/config-typescript": "workspace:*",
    "@types/debug": "^4.1.13",
    "@types/json-pointer": "^1.0.34",
    "json-stringify-pretty-compact": "^4.0.0",
    "rimraf": "^6.1.3"
  }
}
