{
  "name": "omnigen",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "version": "0.0.6",
  "private": false,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "test": "vitest run",
    "test-report": "REPORT=true vitest run",
    "test:watch": "vitest",
    "dev": "turbo run dev --parallel",
    "lint": "eslint src/**/*.ts --fix",
    "sync:prepare": "syncpack list-mismatches",
    "sync:execute": "syncpack fix-mismatches",
    "update": "pnpm up -r",
    "version-patch": "pnpm version patch && turbo run version-patch",
    "publish-snapshot": "turbo run publish-snapshot",
    "publish-release": "turbo run publish-release",
    "ts-profile-compile": "tsc -p ./tsconfig.trace.json --noEmit --generateTrace .ts-trace",
    "ts-profile-install": "npm install --no-save @typescript/analyze-trace",
    "ts-profile-analyze": "npx analyze-trace .ts-trace",
    "ts-profile": "pnpm run ts-profile-compile && pnpm run ts-profile-install && pnpm run ts-profile-analyze"
  },
  "devDependencies": {
    "@omnigen/config-typescript": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jiti": "^2.6.1",
    "madge": "^8.0.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
