{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:profile": {
      "dependsOn": ["^build:profile"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "version-patch": {
      "cache": false,
      "outputs": []
    },
    "publish-snapshot": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "publish-release": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "update": {
      "cache": false
    }
  }
}
